#!/usr/bin/env bash

# Mac Cleaner CLI Entry Point

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
export DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
export SRC="$DIR/src"

source "$SRC/common.sh"
source "$SRC/scanner.sh"
source "$SRC/cleanup.sh"
source "$SRC/caches.sh"
source "$SRC/snapshots.sh"
source "$SRC/developer.sh"
source "$SRC/package_managers.sh"
source "$SRC/docker.sh"
source "$SRC/backups.sh"
source "$SRC/advanced.sh"
source "$SRC/duplicate_finder.sh"

show_help() {
    echo "Usage: mac-cleaner [COMMAND] [OPTIONS]"
    echo ""
    echo "Commands:"
    echo "  (none)      Start interactive menu"
    echo "  scan        Scan storage and show potentially reclaimable space"
    echo "  clean       Start interactive menu (same as no command)"
    echo "  snapshots   Manage Time Machine snapshots"
    echo ""
    echo "Options:"
    echo "  --dry-run   Do not delete anything, just show what would happen"
    echo "  -h, --help  Show this help"
    echo ""
}

load_scan_stats() {
    load_disk_info
    MC_USER_CACHES=$(scan_user_caches)
    MC_SYS_CACHES=$(scan_system_caches)
    MC_SNAPS=$(scan_snapshots)
    MC_XCODE=$(scan_xcode)
    MC_BREW=$(scan_homebrew)
    MC_NPM=$(scan_npm)
    MC_BACKUPS=$(scan_backups)
    MC_DOCKER=$(scan_docker)
    MC_TOTAL=$((MC_USER_CACHES + MC_SYS_CACHES + MC_XCODE + MC_BREW + MC_NPM + MC_BACKUPS + MC_DOCKER))
}

print_scan_summary() {
    echo -e "${BOLD}Disk${RESET}"
    echo -e "${CYAN}────────────────────────────────────────────${RESET}"
    printf "%-30s %s\n" "Used" "$(format_bytes "$MC_DISK_USED")"
    printf "%-30s %s\n" "Free" "$(format_bytes "$MC_DISK_FREE")"
    printf "%-30s %s\n" "Capacity" "$(format_bytes "$MC_DISK_TOTAL")"
    echo ""

    echo -e "${BOLD}Reclaimable${RESET}"
    echo -e "${CYAN}────────────────────────────────────────────${RESET}"
    printf "%-38s %s\n" "User caches" "$(format_bytes "$MC_USER_CACHES")"
    printf "%-38s %s\n" "System caches" "$(format_bytes "$MC_SYS_CACHES")"
    printf "%-38s %s\n" "Time Machine snapshots" "${MC_SNAPS} snapshots"
    printf "%-38s %s\n" "Xcode DerivedData" "$(format_bytes "$MC_XCODE")"
    printf "%-38s %s\n" "Homebrew cache" "$(format_bytes "$MC_BREW")"
    printf "%-38s %s\n" "npm cache" "$(format_bytes "$MC_NPM")"
    printf "%-38s %s\n" "iPhone/iPad backups" "$(format_bytes "$MC_BACKUPS")"
    printf "%-38s %s\n" "Docker reclaimable" "$(format_bytes "$MC_DOCKER")"
    echo ""
    printf "%-38s %s\n" "Potential total" "$(format_bytes "$MC_TOTAL")"
    echo ""
}

run_scan() {
    print_header "MAC CLEANER"
    print_dry_run_banner
    echo -e "${YELLOW}Scanning storage, please wait...${RESET}"
    load_scan_stats
    echo ""
    print_scan_summary
}

run_menu() {
    local need_scan=1
    local option

    while true; do
        if [[ $need_scan -eq 1 ]]; then
            clear
            print_header "MAC CLEANER"
            print_dry_run_banner
            echo -e "${YELLOW}Scanning storage, please wait...${RESET}"
            load_scan_stats
            need_scan=0
        fi

        clear
        print_header "MAC CLEANER"
        print_dry_run_banner

        echo -e "${BOLD}Disk${RESET}"
        echo -e "${CYAN}────────────────────────────────────────────${RESET}"
        printf "%-30s %s\n" "Used" "$(format_bytes "$MC_DISK_USED")"
        printf "%-30s %s\n" "Free" "$(format_bytes "$MC_DISK_FREE")"
        printf "%-30s %s\n" "Capacity" "$(format_bytes "$MC_DISK_TOTAL")"
        echo ""

        echo -e "${BOLD}Cleanup options${RESET}"
        echo -e "${CYAN}────────────────────────────────────────────${RESET}"
        echo ""
        printf "  1. %-35s %s\n" "Clean user caches" "$(format_bytes "$MC_USER_CACHES")"
        printf "  2. %-35s %s\n" "Clean system caches" "$(format_bytes "$MC_SYS_CACHES")"
        printf "  3. %-35s %s\n" "Manage Time Machine snapshots" "${MC_SNAPS} snapshots"
        printf "  4. %-35s %s\n" "Clean Xcode DerivedData" "$(format_bytes "$MC_XCODE")"
        printf "  5. %-35s %s\n" "Run Homebrew cleanup" "$(format_bytes "$MC_BREW")"
        printf "  6. %-35s %s\n" "Clean npm cache" "$(format_bytes "$MC_NPM")"
        printf "  7. %-35s %s\n" "Remove iPhone/iPad backups" "$(format_bytes "$MC_BACKUPS")"
        printf "  8. %-35s %s\n" "Prune unused Docker data" "$(format_bytes "$MC_DOCKER")"
        printf "  9. %-35s %s\n" "Clean all caches (1, 2, 4, 5, 6)" "$(format_bytes $((MC_USER_CACHES + MC_SYS_CACHES + MC_XCODE + MC_BREW + MC_NPM)))"
        printf " 10. %-35s\n" "More options..."
        echo ""
        printf "  0. %-35s\n" "Exit"
        echo ""
        echo -e "${CYAN}────────────────────────────────────────────${RESET}"
        printf "     %-35s %s\n" "Potential total" "$(format_bytes "$MC_TOTAL")"
        echo ""

        echo -e -n "${CYAN}Select an option:${RESET} "
        read -r option || exit 0

        echo ""
        case "$option" in
            1) clean_user_caches; need_scan=1 ;;
            2) clean_system_caches; need_scan=1 ;;
            3) manage_snapshots; need_scan=1 ;;
            4) clean_xcode; need_scan=1 ;;
            5) clean_homebrew; need_scan=1 ;;
            6) clean_npm; need_scan=1 ;;
            7) clean_backups; need_scan=1 ;;
            8) clean_docker; need_scan=1 ;;
            9)
                clean_user_caches
                clean_system_caches
                clean_xcode
                clean_homebrew
                clean_npm
                need_scan=1
                ;;
           10) run_more_menu; need_scan=1; continue ;;
            0) echo "Goodbye!"; exit 0 ;;
            *) echo "Invalid option."; sleep 1; continue ;;
        esac

        pause
    done
}

# Main execution
for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        show_help
        exit 0
    fi
done

# Check for dry run
if [[ "$*" == *"--dry-run"* ]]; then
    set_dry_run
fi

case "$1" in
    scan)
        run_scan
        ;;
    clean)
        run_menu
        ;;
    snapshots)
        manage_snapshots
        ;;
    --dry-run)
        run_menu
        ;;
    "")
        run_menu
        ;;
    *)
        if [[ "$1" == -* ]]; then
            show_help
            exit 1
        fi
        run_menu
        ;;
esac
